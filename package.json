{
  "name": "pi-guard-merge",
  "version": "0.1.0",
  "description": "Pi extension: confirm or block unauthorized merge, branch-rule and trunk-push commands before they run.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "guard",
    "merge",
    "confirmation"
  ],
  "homepage": "https://github.com/ZouZhao321/pi-guard-merge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZouZhao321/pi-guard-merge.git"
  },
  "bugs": {
    "url": "https://github.com/ZouZhao321/pi-guard-merge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./src/guard-merge.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/",
    "test": "node scripts/smoke.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run format:check && npm run check:pack"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
